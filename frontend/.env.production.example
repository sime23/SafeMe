# Production Environment Variables for Frontend Deployment (Vercel / Netlify / Render)
# Set VITE_API_BASE_URL to your deployed backend domain + /api/v1/tracking
VITE_API_BASE_URL=https://your-gps-backend.onrender.com/api/v1/tracking

# Optional WebSocket URL (defaults to root of VITE_API_BASE_URL if not provided)
VITE_WS_URL=https://your-gps-backend.onrender.com

# Default Device Identifier
VITE_DEFAULT_DEVICE_ID=ESP-32_Tracker

# Background Polling Interval fallback (ms)
VITE_POLL_INTERVAL_MS=10000
